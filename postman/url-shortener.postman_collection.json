            "url": {
              "raw": "{{baseUrl}}/api/v1/links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "links"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"url\":\"{{dedupeUrl}}\",\"dedupe\":true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same code\", () => pm.expect(pm.response.json().code).to.eql(pm.collectionVariables.get(\"dedupeCode\")));"
                ]
              }
            }
          ]
        }
      ]
