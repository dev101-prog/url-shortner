{
  "info": {
    "name": "URL Shortener",
    "_postman_id": "8f3b0c2e-0d6e-4c1b-9b7a-url-shortener",
    "description": "CUJ-1..CUJ-4 and the \u00a75.2 error cases. Re-runnable: aliases and dedupe URLs are unique per run. Uses the local demo keys from design \u00a74.4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Health",
      "item": [
        {
          "name": "liveness /healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "readiness /readyz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"db UP\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"UP\"); pm.expect(b.checks.db).to.eql(\"UP\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Create",
      "item": [
        {
          "name": "create random code (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{aliceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "links"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"url\":\"https://openjdk.org/projects/jdk/21/\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"7-char base62 code\", () => pm.expect(b.code).to.match(/^[A-Za-z0-9]{7}$/));",
                  "pm.test(\"Location header\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/links/\" + b.code));",
                  "pm.test(\"body fields\", () => { pm.expect(b.status).to.eql(\"active\"); pm.expect(b.target).to.eql(\"https://openjdk.org/projects/jdk/21/\"); pm.expect(b.short_url).to.include(b.code); pm.expect(b).to.have.property(\"expires_at\"); pm.expect(b).to.have.property(\"created_at\"); });",
                  "pm.collectionVariables.set(\"code\", b.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "create custom alias (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{aliceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "links"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"url\":\"https://example.org/promo\",\"alias\":\"{{alias}}\",\"expires_at\":\"{{expiresAt}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique alias per run so the collection is re-runnable",
                  "pm.collectionVariables.set(\"alias\", \"pm-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1e4));",
                  "pm.collectionVariables.set(\"expiresAt\", new Date(Date.now() + 30 * 86400000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"alias is the code\", () => pm.expect(pm.response.json().code).to.eql(pm.collectionVariables.get(\"alias\")));",
                  "pm.test(\"expiry stored\", () => pm.expect(pm.response.json().expires_at).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "dedupe: first create (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
