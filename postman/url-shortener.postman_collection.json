    {
      "name": "3 Redirect, metadata, stats",
      "item": [
        {
          "name": "redirect (302, not followed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{code}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{code}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Location is the target\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"https://openjdk.org/projects/jdk/21/\"));",
                  "pm.test(\"no-store headers\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"private, no-cache, no-store, max-age=0\"));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "metadata (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{aliceKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/links/{{code}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "links",
                "{{code}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// give the click flush (1 s interval) time to run",
                  "setTimeout(() => {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"metadata fields\", () => { pm.expect(b.code).to.eql(pm.collectionVariables.get(\"code\")); pm.expect(b.status).to.eql(\"active\"); pm.expect(b.total_clicks).to.be.at.least(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "stats for seeded aB3dE7x (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{aliceKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/links/aB3dE7x/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "links",
                "aB3dE7x",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"seeded totals\", () => { pm.expect(b.total_clicks).to.be.at.least(6); pm.expect(b.bot_clicks).to.be.at.least(2); pm.expect(b.human_clicks).to.eql(b.total_clicks - b.bot_clicks); });",
                  "pm.test(\"30 zero-filled days\", () => pm.expect(b.clicks_per_day).to.have.lengthOf(30));",
                  "pm.test(\"referrers and countries\", () => { pm.expect(b.top_referrers).to.be.an(\"array\").that.is.not.empty; pm.expect(b.top_countries).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
